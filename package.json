{
  "name": "historical-simulator",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm test && npx expo-doctor",
    "sdk:fix": "expo install --fix",
    "sdk:check": "expo install --check",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "expo": "^57.0.0",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.7.0",
    "react-native-worklets": "~0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
